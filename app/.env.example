# Copy to .env.local (gitignored by Vite's default patterns) and adjust as
# needed. VITE_API_BASE just needs to point at any gramps-web-api instance
# reachable from the browser -- live sync polls that same API (see
# src/store/historyPoll.ts), so it works against every dev fixture under
# ../dev-fixtures/, not just a Postgres-backed one. This default points at
# layer3-sync's fixture (see ../dev-fixtures/layer3-sync/api-fixture).
VITE_API_BASE=http://localhost:5003
