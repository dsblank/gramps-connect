# Copy to .env.local (gitignored by Vite's default patterns) and adjust as
# needed. These defaults point at layer3-sync's fixture stack (see
# ../layer3-sync/api-fixture and ../layer3-sync/relay.py) -- the only one of
# the three Layer 2/3 fixtures backed by real Postgres with live sync wired
# up; the plain-SQLite fixtures have nothing listening on VITE_WS_URL.
VITE_API_BASE=http://localhost:5003
VITE_WS_URL=ws://localhost:8766
