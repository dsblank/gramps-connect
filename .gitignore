venv/
__pycache__/
*.pyc
node_modules/
dist/
*~

# dev-fixtures/layer2-local-cache: generated/fetched, not source
dev-fixtures/

# app: sql.js WASM binaries and maplibre-gl's worker + its shared.mjs
# sibling, all copied in by scripts/copy-wasm.mjs, not source. Only the
# copies, not the directory: public/ also holds the favicon set, which is
# artwork we keep. No other .mjs file belongs in public/, so that extension
# is excluded outright rather than naming the two maplibre files.
app/public/*.wasm
app/public/*.mjs

# app: pyodide runtime assets (PoC, see app/src/pyodidePoc/), also copied
# in by scripts/copy-wasm.mjs -- whole subdirectory since it's several
# files (.wasm/.mjs/.json/.zip) all generated, none of them source.
app/public/pyodide/

# app: gramps wheel (PoC, see app/src/pyodidePoc/), best-effort copy by
# scripts/copy-wasm.mjs from dist/gramps-wheel/ (itself gitignored via the
# blanket `dist/` rule above) -- generated, not source.
app/public/gramps-wheel/

# app: plotly.js itself (PoC, see app/src/pyodidePoc/pyodideWorker.ts's
# plotly print() hook), also copied in by scripts/copy-wasm.mjs -- named
# explicitly rather than *.js, unlike the *.wasm/*.mjs rules above: .js is
# common enough that a wildcard here could silently swallow a real,
# hand-written source file dropped into public/ later.
app/public/plotly.min.js

# app: local dev overrides of .env.example -- machine-specific, not source
app/.env.local

# standalone: PyInstaller build output + files copied in by the build
# workflow (app/dist) -- not source
standalone/build/
standalone/frontend/

# standalone: gramps-web-api's filesystem caches, written to whatever the
# server process's cwd was when run locally from standalone/ -- not source
standalone/persistent_cache/
standalone/request_cache/
standalone/thumbnail_cache/

# repo root: same gramps-web-api filesystem caches, this time from a
# server process run with the repo root itself as cwd -- not source
/persistent_cache/
/request_cache/
/thumbnail_cache/

# deploy: real secrets/config, machine- and deployment-specific -- not source
deploy/.env
