# app: sql.js WASM binaries and maplibre-gl's worker + its shared.mjs
# sibling, all copied in by scripts/copy-wasm.mjs, not source. Only the
# copies, not the directory: public/ also holds the favicon set, which is
# artwork we keep. No other .mjs file belongs in public/, so that extension
# is excluded outright rather than naming the two maplibre files.
app/public/*.wasm
app/public/*.mjs

# app: local dev overrides of .env.example -- machine-specific, not source
app/.env.local

# standalone: PyInstaller build output + files copied in by the build
# workflow (app/dist) -- not source
standalone/build/
standalone/frontend/

# standalone: gramps-web-api's filesystem caches, written to whatever the
# server process's cwd was when run locally from standalone/ -- not source
standalone/persistent_cache/
standalone/request_cache/
standalone/thumbnail_cache/

# deploy: real secrets/config, machine- and deployment-specific -- not source
deploy/.env
