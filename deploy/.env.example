# Copy to .env (gitignored) and fill in real values before running
# `docker compose -f deploy/docker-compose.yml --env-file deploy/.env up`.
# Never commit deploy/.env.

# Postgres role/database used for the SharedPostgreSQL tree backend. The
# postgres:16 image creates this role as a superuser on first boot, which
# SharedPostgreSQL needs to create a database per tree.
POSTGRES_USER=gramps
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gramps

# Seeded on first boot as a site admin (role 5 -- required in multi-tree
# mode). Required; there is no "admin"/"admin" fallback.
GRAMPSWEB_ADMIN_USER=admin
GRAMPSWEB_ADMIN_PASSWORD=change-me

# Flask secret key (JWT signing, sessions, etc). Leave blank to have the
# entrypoint generate a random one and persist it to the app-secret volume
# on first boot instead.
GRAMPSWEB_SECRET_KEY=

# Public URL this deployment is reachable at (used to build links in emails
# etc). caddy terminates TLS in front of app (see deploy/Caddyfile) and is
# the only published entrypoint, so this should be the https:// hostname
# browsers actually reach caddy at -- update to your real domain once one
# is configured (see deploy/Caddyfile's comments).
PUBLIC_URL=https://localhost

# Leave blank unless a *separately hosted* gramps-web (or other
# gramps-web-api client) frontend needs to call this backend's /api/ from
# its own origin -- this backend is the same unmodified gramps-web-api
# image gramps-web itself runs on, so it's compatible, but Flask-Cors
# rejects cross-origin requests by default. Set to that frontend's origin
# (e.g. https://gramps-web.example.com), or "*" to allow any.
GRAMPSWEB_CORS_ORIGINS=
