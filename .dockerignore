# Only the generated sql.js/maplibre-gl copies, not the whole directory:
# public/ also holds the tracked favicon set that index.html references by
# absolute path (same split .gitignore already makes). npm ci's postinstall
# hook (app/scripts/copy-wasm.mjs) re-creates these inside the build.
app/public/*.wasm
app/public/*.mjs
**/__pycache__
*.pyc
